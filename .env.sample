SENTRY_DSN=""

# Default proxy for all services. Leave empty for the Requests defaults.
FEEDGEN_HTTP_PROXY=""

# Per-service overrides. Empty values inherit FEEDGEN_HTTP_PROXY.
# Examples: socks5h://127.0.0.1:1080 or socks5h://user:password@proxy.example:1080
FEEDGEN_104_PROXY=""
FEEDGEN_1111_PROXY=""
FEEDGEN_518_PROXY=""
FEEDGEN_BOOKWALKER_PROXY=""
FEEDGEN_CAKERESUME_PROXY=""
FEEDGEN_DCARD_PROXY=""
FEEDGEN_MOMOSHOP_PROXY=""
FEEDGEN_PCHOME_PROXY=""
FEEDGEN_PLURK_PROXY=""
FEEDGEN_RENT591_PROXY=""
FEEDGEN_SHOPEE_PROXY=""
FEEDGEN_TAIPEIMETROTIMETABLE_PROXY=""
FEEDGEN_YOURATOR_PROXY=""
FEEDGEN_YOUTUBE_PROXY=""

# curl_cffi impersonate targets (comma-separated; one is picked at random per
# session). Per-service keys override FEEDGEN_IMPERSONATE; empty values fall
# back to the built-in defaults for services that need them.
FEEDGEN_IMPERSONATE=""

FEEDGEN_104_IMPERSONATE="chrome136,chrome146,chrome150"

# Dcard uses one target matching FEEDGEN_CFSOLVE_PROFILE, ignoring the global
# impersonate setting. Do not use a comma-separated list here.
FEEDGEN_DCARD_IMPERSONATE="safari260_ios"

# Installed by make deploy on the server, or make cfsolve for local development.
FEEDGEN_CFSOLVE_BINARY="./.cfsolve/target/release/challenge"
FEEDGEN_CFSOLVE_PROFILE="./.cfsolve/profiles/safari-26-ios.json"
FEEDGEN_CFSOLVE_ATTEMPTS="3"
FEEDGEN_CFSOLVE_TIMEOUT="300"
